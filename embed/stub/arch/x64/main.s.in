.section ".text.stub"

.p2align 5
.global main
main:
	pushq %rdi
	// call _lfi_thread_create(&_lfi_pause)
	leaq _lfi_pause(%rip), %rdi
	leaq .Lret(%rip), %rsi
	pushq %rsi
	jmp _lfi_thread_create
.p2align 5
.Lret:
	popq %rdi
	// load address of trampoline table and then exit
	leaq trampotable(%rip), %rdi
.p2align 5
.global _lfi_pause
_lfi_pause:
	mov $60, %rax
	syscall
	int3

.section ".text.trusted"
.p2align 5
.global _lfi_retfn
_lfi_retfn:
	leaq 1024f(%rip), %r11
	jmpq *24(%r14)
	1024:
	int3

.section ".data.trampotable"
.global trampotable
trampotable:
{{- range $sym := .exported }}
	.quad {{$sym.Name}}
{{- end }}
{{- range $sym := .exposed}}
	.quad {{$sym}}
{{- end}}
.section .note.GNU-stack,"",@progbits
